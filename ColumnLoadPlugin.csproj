<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net48;net8.0-windows</TargetFrameworks>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <Configurations>Release;Debug</Configurations>
    <AssemblyName>ColumnLoadPlugin</AssemblyName>
    <RootNamespace>StructuralTakedown</RootNamespace>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!-- Targets AutoCAD 2021-2024 (.NET Framework 4.8) -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="AutoCAD.NET" Version="24.1.511" ExcludeAssets="runtime" />
    <PackageReference Include="AutoCAD.NET.Core" Version="24.1.511" ExcludeAssets="runtime" />
    <PackageReference Include="AutoCAD.NET.Model" Version="24.1.511" ExcludeAssets="runtime" />
  </ItemGroup>

  <!-- Targets AutoCAD 2025-2026 (.NET 8.0) -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <PackageReference Include="AutoCAD.NET" Version="25.0.0" ExcludeAssets="runtime" />
    <PackageReference Include="AutoCAD.NET.Core" Version="25.0.0" ExcludeAssets="runtime" />
    <PackageReference Include="AutoCAD.NET.Model" Version="25.0.0" ExcludeAssets="runtime" />
  </ItemGroup>

</Project>
